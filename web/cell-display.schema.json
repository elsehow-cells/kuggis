{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kuggis cell display grouping (not an enforced cell policy)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cell", "projects"],
  "properties": {
    "version": {"const": 1},
    "cell": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "not": {"enum": ["operator", "unassigned"]}},
    "projects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "not": {"const": "kuggis"}}},
    "definition": {"type": "object"}
  }
}
