{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kuggis development-cell contract v2",
  "description": "Desired development configuration, not a security certificate. Semantic validation additionally rejects ownership conflicts and identical development/upstream repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cell",
    "merge",
    "spending",
    "projects",
    "doors"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "cell": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "merge": {
      "const": {
        "strategy": "squash",
        "checks": [
          "cell-test",
          "cell-review"
        ],
        "human_approvals": 0
      }
    },
    "spending": {
      "const": "ask"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repo",
          "upstream",
          "vm",
          "profile",
          "branch",
          "test"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "upstream": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "vm": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "profile": {
            "type": "string",
            "pattern": "^(-|[a-z][a-z0-9-]{0,62})$"
          },
          "branch": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "test": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "doors": {
      "const": {
        "upstream": "yours",
        "publish": "yours",
        "submission": "yours",
        "private_data": "yours"
      }
    }
  }
}
