{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kuggis VM job event v1",
  "description": "VM-local shadow events, not authorization evidence. Maximum serialized line: 4096 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "seq",
    "time",
    "session_id",
    "run_id",
    "name",
    "agent",
    "event",
    "why"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "time": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "agent": {
      "enum": [
        "claude",
        "codex",
        "pi"
      ]
    },
    "event": {
      "enum": [
        "closed",
        "idle",
        "needs_you",
        "prompt",
        "starting",
        "stopped",
        "waiting",
        "working"
      ]
    },
    "why": {
      "enum": [
        "",
        "blocked",
        "done",
        "permission",
        "question"
      ]
    }
  },
  "if": {
    "properties": {
      "event": {
        "enum": [
          "waiting",
          "needs_you"
        ]
      }
    }
  },
  "then": {
    "properties": {
      "why": {
        "enum": [
          "blocked",
          "done",
          "permission",
          "question"
        ]
      }
    }
  },
  "else": {
    "properties": {
      "why": {
        "const": ""
      }
    }
  }
}
