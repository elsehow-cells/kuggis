#!/usr/bin/env bash
# box: stamp every commit made on this VM with where it came from, as a
# trailer beside Claude's Co-Authored-By:
#   Box: <vm>/<session> (<agent>)
# so `git log --grep '^Box:'` lists everything the VMs wrote. Installed
# through the global core.hooksPath by bootstrap.sh.
session=${BOX_SESSION:-}
if [ -n "$session" ]; then
  agent=$(cat ~/.box/agent/"$session" 2>/dev/null || echo claude)
else
  session=shell agent=manual
fi
git interpret-trailers --in-place --if-exists doNothing \
  --trailer "Box: $(hostname)/$session ($agent)" "$1"
